{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["tools/**/*.ts", "apps/**/*.ts", "tests/**/*.ts"]
}
